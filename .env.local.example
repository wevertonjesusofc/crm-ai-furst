NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# opção gratuita pra testar: aistudio.google.com/apikey
GEMINI_API_KEY=

# opção real (produção): console.anthropic.com > API Keys — tem prioridade se preenchida
ANTHROPIC_API_KEY=

# Chave secreta do Supabase (Project Settings > API > service_role / secret).
# Só o servidor usa (MCP, tokens, painel de clientes). NUNCA coloque NEXT_PUBLIC_ na frente.
SUPABASE_SERVICE_ROLE_KEY=

# Obrigatória em produção: texto longo e aleatório (a Vercel usa para a rotina das 7h).
CRON_SECRET=
